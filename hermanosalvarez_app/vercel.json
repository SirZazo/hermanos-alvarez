{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/servicios-discrecionales",
      "destination": "/seo/servicios-discrecionales.html"
    },
    {
      "source": "/horarios/vcm-618-torrijos-toledo",
      "destination": "/seo/vcm-618-torrijos-toledo.html"
    },
    {
      "source": "/horarios/vcm-042-almorox-torrijos",
      "destination": "/seo/vcm-042-almorox-torrijos.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/servicios-discrecionales/solicitar-presupuesto",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
